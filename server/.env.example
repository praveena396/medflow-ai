# Copy this file to .env and fill in real values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Server Configuration
PORT=5000
NODE_ENV=development
# Behind a proxy or load balancer (Render, nginx), trust one hop so per-IP
# rate limits see the client's address: TRUST_PROXY=1
# TRUST_PROXY=
# Consume background jobs inside the API process instead of `npm run worker`
# (handy on a host where a second process costs extra).
# RUN_WORKERS_IN_PROCESS=true

# Database
MONGO_URI=mongodb://localhost:27017/medflow
# Production (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/medflow

# JWT — MUST be long random strings, and different from each other
JWT_SECRET=change_me_generate_a_random_64_char_secret
JWT_REFRESH_SECRET=change_me_generate_a_different_random_64_char_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Refresh-token cookie (httpOnly, scoped to /api/auth). Browsers accept Secure
# cookies on http://localhost; set REFRESH_COOKIE_SECURE=false only if yours
# doesn't. Use REFRESH_COOKIE_SAMESITE=none (with Secure) when the client and
# API are on different sites, e.g. a Vercel client and a Render API.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict

# Per-user limit on /api/chat and /api/triage (requests per window)
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000

# Redis (job queue, cache, rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# Or one URL, which wins over the three above. Use rediss:// for TLS (Upstash):
# REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# AI / LLM — 'ollama' (free, local) or 'openai'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_CHAT_MODEL=llama3.2
LLM_EMBEDDING_MODEL=nomic-embed-text
# Minimum cosine similarity (0-1) a document chunk needs to be used as context.
# If no chunk reaches it, the chatbot declines ("not enough information in your
# documents") without calling the LLM. Default 0.45; raise it to decline more often.
RAG_SIMILARITY_THRESHOLD=0.45
# After retrieval, ask the chat model (one short JSON-only call) whether the
# retrieved chunks actually contain the answer, and decline if they don't.
# Set to false for the similarity-only decision.
RAG_GROUNDING_CHECK=true
# For OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Vector store for document chunks — 'mongo' (default: embeddings in MongoDB,
# cosine similarity in Node) or 'chroma' (a ChromaDB server). Switching does not
# copy existing chunks; upload documents again after changing it.
VECTOR_STORE=mongo
# For ChromaDB (docker compose --profile chroma up -d):
# VECTOR_STORE=chroma
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=medflow_chunks     # the embedding model's name is appended
# CHROMA_TENANT=
# CHROMA_DATABASE=

# File Storage — 'local' (dev) or 's3' (AWS S3 or MinIO)
FILE_STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# For S3/MinIO:
# FILE_STORAGE_TYPE=s3
# S3_BUCKET=medflow-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=http://localhost:9000   # only for MinIO / S3-compatible stores (e.g. Cloudflare R2)
# Downloads redirect to a pre-signed GET URL that expires after this many seconds.
# DOWNLOAD_URL_EXPIRY_SECONDS=900

# Notifications
# EMAIL_DRIVER: 'ethereal' (free test inbox), 'smtp' (real), or 'mock' (log only)
EMAIL_DRIVER=ethereal
# For real SMTP:
# EMAIL_DRIVER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=app_password
# EMAIL_FROM=MedFlow AI <no-reply@yourdomain.com>

# SMS_DRIVER: 'mock' (log only) or 'twilio'
SMS_DRIVER=mock
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE=+1234567890

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=debug
